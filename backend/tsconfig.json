{
  "compilerOptions": {

    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",

    "allowImportingTsExtensions": false,
    "noEmit": false,
  

   
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
  } 
}
